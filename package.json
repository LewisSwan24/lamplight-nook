{
  "name": "lamplight-nook",
  "productName": "Lamplight Nook",
  "version": "0.4.1",
  "private": true,
  "description": "A cozy pixel-art desktop app that turns long AI tasks into the daily life of a small cafe crew.",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/notices.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "smoke": "npm run build && electron scripts/smoke.cjs smoke-shots",
    "record": "tsx scripts/record.ts",
    "dist": "electron-vite build && node scripts/notices.mjs && electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "phaser": "^3.90.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.306"
  },
  "build": {
    "appId": "com.lewisswan.lamplightnook",
    "productName": "Lamplight Nook",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "demo/check.js",
      "assets/fonts/hand-OFL.txt",
      "assets/ui/icon.png",
      "assets/ui/tray.png",
      "assets/ui/tray-glow.png",
      "package.json",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**"
    ],
    "win": {
      "icon": "assets/ui/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Lamplight-Nook-Setup-${version}.${ext}"
    }
  }
}
