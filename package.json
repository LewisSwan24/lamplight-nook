{
  "name": "lamplight-nook",
  "productName": "Lamplight Nook",
  "version": "0.1.0",
  "private": true,
  "description": "A cozy pixel-art desktop app that turns long AI tasks into the daily life of a small cafe crew.",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "smoke": "electron-vite build && electron scripts/smoke.cjs smoke-shots",
    "record": "tsx scripts/record.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "^38.8.6",
    "electron-vite": "^6.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.306",
    "phaser": "^3.90.0",
    "yaml": "^2.9.1"
  }
}